# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id_here

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Pexels (Free Stock Videos)
PEXELS_API_KEY=your_pexels_api_key_here

# GitHub (for auto-push)
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO_OWNER=your_github_username_here
GITHUB_REPO_NAME=telegram-ai-reel-automation

# ElevenLabs (AI Voice - optional, free tier available)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# App Config
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Storage
STORAGE_PATH=./storage/reels
TEMP_PATH=./storage/temp
